<?xml version='1.0' encoding='utf-8'?>
<widget id="com.gameanalytics.cordovatest" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>GA_SDK_CORDOVA_DEV</name>
    <description>
        GameAnalytics Cordova SDK development app.
    </description>
    <author email="sdk@gameanalytics.com" href="https://gameanalytics.com/">
        GameAnalytics
    </author>
    <preference name="BackupWebStorage" value="none" />
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    <platform name="android">
        <allow-intent href="market:*" />
    </platform>
    <platform name="ios">
        <allow-intent href="itms:*" />
        <allow-intent href="itms-apps:*" />
    </platform>
    <plugin name="cordova-plugin-whitelist" spec="^1.3.3" />
    <plugin name="cordova-plugin-gameanalytics" spec="gameanalytics" />
</widget>
