{
    "name": "com.gameanalytics.cordovatest",
    "displayName": "GameAnalyticsSample",
    "version": "1.0.0",
    "description": "A sample Apache Cordova application that responds to the deviceready event.",
    "main": "index.js",
    "scripts": {
        "test": "npm run test:js && npm run test:static",
        "test:js": "node --test \"test/js/*.test.js\"",
        "test:static": "node test/static/check.js",
        "test:android": "gradle -p test/android test",
        "test:ios": "test/ios/run-unit-tests.sh"
    },
    "author": "Apache Cordova Team",
    "license": "Apache-2.0",
    "dependencies": {
        "cordova-android": "^15.1.0",
        "cordova-ios": "^8.2.0",
        "cordova-plugin-gameanalytics": "file:gameanalytics"
    },
    "cordova": {
        "plugins": {
            "cordova-plugin-gameanalytics": {}
        },
        "platforms": [
            "android",
            "ios"
        ]
    }
}
